    objs.tools.Center = true
    objs.tools.Outline = true
    objs.tools.Color = Color3.fromRGB(255, 220, 80)
    objs.tools.Font = 2
    objs.tools.Visible = false

    ESP_Objects[plr] = objs
end

local function RemoveESPForPlayer(plr)
    local objs = ESP_Objects[plr]
    if not objs then return end
    for _, obj in pairs(objs) do
        pcall(function() obj:Remove() end)
    end
    ESP_Objects[plr] = nil
end

for _, plr in pairs(Players:GetPlayers()) do
    CreateESPForPlayer(plr)
end
Players.PlayerAdded:Connect(CreateESPForPlayer)
Players.PlayerRemoving:Connect(RemoveESPForPlayer)

RunService.RenderStepped:Connect(function()
    if not EspEnabled then
        for _, objs in pairs(ESP_Objects) do
            for _, o in pairs(objs) do
                o.Visible = false
            end
        end
        return
    end

    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local localPos = localHRP and localHRP.Position
    local localTeam = LocalPlayer.Team

    for plr, objs in pairs(ESP_Objects) do
        local char = plr.Character
        if not char then
            for _, o in pairs(objs) do o.Visible = false end
            continue
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")

        if not hum or not hrp or not head or hum.Health <= 0 then
            for _, o in pairs(objs) do o.Visible = false end
            continue
        end

        if EspTeamCheck and plr.Team == localTeam then
            for _, o in pairs(objs) do o.Visible = false end
            continue
        end

        local dist = localPos and (hrp.Position - localPos).Magnitude or 0
        if dist > EspDistance then
            for _, o in pairs(objs) do o.Visible = false end
            continue
        end

        local headScreen, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.2, 0))
        local rootScreen, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.8, 0))

        if not headOnScreen or not rootOnScreen then
            for _, o in pairs(objs) do o.Visible = false end
            continue
        end

        local topY = headScreen.Y
        local botY = rootScreen.Y
        local centerX = headScreen.X

        if EspName then
            objs.name.Text = plr.Name
            objs.name.Position = Vector2.new(centerX, topY - 18)
            objs.name.Visible = true
        else
            objs.name.Visible = false
        end

        if EspHealth then
            local barWidth = 60
            local barHeight = 6
            local barX = centerX - barWidth / 2
            local barY = topY - 6
            local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)

            objs.healthBG.Size = Vector2.new(barWidth, barHeight)
            objs.healthBG.Position = Vector2.new(barX, barY)
            objs.healthBG.Visible = true

            objs.healthFill.Size = Vector2.new(barWidth * hpRatio, barHeight)
            objs.healthFill.Position = Vector2.new(barX, barY)
            if hpRatio > 0.6 then
                objs.healthFill.Color = Color3.fromRGB(0, 255, 0)
            elseif hpRatio > 0.3 then
                objs.healthFill.Color = Color3.fromRGB(255, 200, 0)
            else
                objs.healthFill.Color = Color3.fromRGB(255, 40, 40)
            end
            objs.healthFill.Visible = true

            objs.healthText.Text = string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
            objs.healthText.Position = Vector2.new(centerX, botY + 4)
            objs.healthText.Visible = true
        else
            objs.healthBG.Visible = false
            objs.healthFill.Visible = false
            objs.healthText.Visible = false
        end

        if EspTools then
            local toolList = {}
            for _, child in pairs(char:GetChildren()) do
                if child:IsA("Tool") then
                    table.insert(toolList, child.Name)
                end
            end
            if #toolList > 0 then
                objs.tools.Text = "🎒 " .. table.concat(toolList, ", ")
                objs.tools.Position = Vector2.new(centerX, botY + 20)
                objs.tools.Visible = true
            else
                objs.tools.Visible = false
            end
        else
            objs.tools.Visible = false
        end
    end
end)

