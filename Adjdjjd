    objs.healthBG.Visible = false

    objs.healthFill = Drawing.new("Square")
    objs.healthFill.Thickness = 0
    objs.healthFill.Filled = true
    objs.healthFill.Color = Color3.fromRGB(0, 255, 0)
    objs.healthFill.Visible = false

