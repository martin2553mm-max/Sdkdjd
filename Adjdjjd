local function HookTool(tool)
   if not tool:IsA("Tool") then return end
   if tool:GetAttribute("TREZ_Hooked") then return end
   tool:SetAttribute("TREZ_Hooked", true)
   tool.Activated:Connect(function()
      if MultiShotEnabled then
         task.wait(0.02)
         pcall(function() tool:Activate() end)
      end
   end)
end

local function HookCharacter(char)
   for _, child in pairs(char:GetChildren()) do HookTool(child) end
   char.ChildAdded:Connect(function(child)
      task.wait(0.1); HookTool(child)
   end)
end

if LocalPlayer.Character then HookCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(HookCharacter)

-- ===== Invisible =====
local function SetCharacterTransparency(char, transparency)
   if not char then return end
   for _, part in pairs(char:GetDescendants()) do
      if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
         pcall(function() part.Transparency = transparency end)
         pcall(function() part.LocalTransparencyModifier = transparency end)
      elseif part:IsA("Decal") or part:IsA("Texture") then
         pcall(function() part.Transparency = transparency end)
      elseif part:IsA("BillboardGui") or part:IsA("Highlight") or part:IsA("SelectionBox") then
         pcall(function() part.Enabled = (transparency == 0) end)
      end
   end
   local hum = char:FindFirstChildOfClass("Humanoid")
   if hum then
      hum.NameDisplayDistance = (transparency == 1) and 0 or 100
      hum.HealthDisplayDistance = (transparency == 1) and 0 or 100
   end
   for _, acc in pairs(char:GetChildren()) do
      if acc:IsA("Accessory") then
         local handle = acc:FindFirstChild("Handle")
         if handle then
            pcall(function() handle.Transparency = transparency end)
            pcall(function() handle.LocalTransparencyModifier = transparency end)
         end
      end
   end
end

