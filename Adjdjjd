RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if SilentAimEnabled then
        CurrentTarget = GetClosestPlayer()
    else
        CurrentTarget = nil
    end

    -- วาดเส้นสีแดงจากกลางจอ → เป้า
    if CurrentTarget and CurrentTarget.Character
       and CurrentTarget.Character:FindFirstChild(AimPart) and ShowAimLine
    then
        local targetPos = CurrentTarget.Character[AimPart].Position
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if onScreen then
            AimLine.From = center
            AimLine.To = Vector2.new(screenPos.X, screenPos.Y)
            AimLine.Visible = true
        else
            AimLine.Visible = false
        end
    else
        AimLine.Visible = false
    end
end)

-- =================================================================
-- ===== SILENT AIM v2 (Hook หลายจุด) =====
-- =================================================================
local function GetTargetPosition()
    if not SilentAimEnabled then return nil end
    if not CurrentTarget or not CurrentTarget.Character then return nil end
    local part = CurrentTarget.Character:FindFirstChild(AimPart)
    if not part then return nil end
    return part.Position
end

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

-- 1) Hook ray methods (FindPartOnRay / Raycast)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    local targetPos = GetTargetPosition()

    if targetPos then
        -- Raycast(origin, direction, params)
        if method == "Raycast" then
            local origin = args[1]
            if typeof(origin) == "Vector3" then
                args[2] = targetPos - origin
            end
            return oldNamecall(self, unpack(args))
        end

        -- FindPartOnRay / FindPartOnRayWithIgnoreList / Whitelist
        if method == "FindPartOnRay"
           or method == "FindPartOnRayWithIgnoreList"
           or method == "FindPartOnRayWithWhitelist" then
            local ray = args[1]
            if typeof(ray) == "Ray" then
                args[1] = Ray.new(ray.Origin, (targetPos - ray.Origin).Unit * 5000)
            end
            return oldNamecall(self, unpack(args))
        end
    end

    return oldNamecall(self, ...)
end)

-- 2) Hook Mouse.Hit / Mouse.Target / Mouse.UnitRay
mt.__index = newcclosure(function(self, key)
    if SilentAimEnabled and typeof(self) == "Instance" and self:IsA("Mouse") then
        local targetPos = GetTargetPosition()
        if targetPos then
            if key == "Hit" then
                return CFrame.new(targetPos)
            elseif key == "Target" then
                if CurrentTarget and CurrentTarget.Character then
                    return CurrentTarget.Character[AimPart]
                end
            elseif key == "UnitRay" then
                local origin = self.Origin
                return Ray.new(origin, (targetPos - origin).Unit)
            end
        end
    end
    return oldIndex(self, key)
end)

setreadonly(mt, true)

