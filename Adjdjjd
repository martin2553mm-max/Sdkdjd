end)
Body.MouseLeave:Connect(function()
    TweenService:Create(BodyStroke, TweenInfo.new(0.2), { Thickness = 1.2 }):Play()
    TweenService:Create(Body, TweenInfo.new(0.2), { BackgroundTransparency = 0.05 }):Play()
end)

